#!/bin/sh
# Push-time secret scan, shared by the jj alias and the Git pre-push hook.
#
# Usage: secret-scan git        (plain git repository; run from inside it)
#        secret-scan git-hook   (same, for the pre-push hook: also reads git's list of refs being pushed on stdin)
#        secret-scan jj         (jj repository; run from inside it, including from a secondary
#                                jj workspace, which has no .git folder of its own)
#
# It scans every commit that a push could newly publish: everything reachable
# from a local branch or tag but not from any remote, plus the current HEAD (so a
# commit made on a detached HEAD is covered). From the pre-push hook it also scans
# the exact commits being pushed, which covers `git push origin <sha>:ref`.
# In jj mode it also scans every visible jj head, which includes the working-copy
# commit, so work in progress is checked too (it may over-scan; that is the safe side).
#
# Exit 0 = clean (or nothing to scan). Non-zero = do NOT push. If the scan
# cannot be completed for any reason, that also blocks the push.

mode=${1:-git}

# Anything unexpected must block the push, so every failure path calls this.
block() {
  echo "secret-scan: BLOCKED - $*" >&2
  exit 1
}

command -v gitleaks >/dev/null 2>&1 ||
  block "the scan could not be completed: gitleaks is not installed (see docs/PREREQUISITES.md)."
command -v git >/dev/null 2>&1 ||
  block "the scan could not be completed: git is not installed."

case $mode in
  git|git-hook)
    repo=$(git rev-parse --show-toplevel 2>/dev/null) ||
      block "the scan could not be completed: not inside a git repository."
    extra_tips=""
    # HEAD may be on no branch or tag (detached HEAD). Skip it only in a repository with no commits yet.
    if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
      extra_tips=$(git rev-parse HEAD)
    fi
    if [ "$mode" = git-hook ]; then
      # git gives one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>.
      # An all-zero local sha means "delete the remote ref": nothing is sent, so nothing to scan.
      while read -r _lref lsha _rref _rsha; do
        [ -n "$lsha" ] || continue
        case $lsha in
          *[!0-9a-f]*) block "the scan could not be completed: unexpected object name from git: '$lsha'." ;;
          *[!0]*) extra_tips="$extra_tips
$lsha" ;;
        esac
      done
    fi
    ;;
  jj)
    command -v jj >/dev/null 2>&1 ||
      block "the scan could not be completed: jj is not installed."
    repo=$(jj root 2>/dev/null) ||
      block "the scan could not be completed: not inside a jj repository."
    # The commits live in a git store that is not always at $repo/.git: a secondary jj workspace
    # has no .git folder at all and shares the store of the main workspace. Ask jj where it is
    # and point git (and through it gitleaks) there. If it cannot be found, block: never guess.
    gitdir=$(jj git root 2>/dev/null) ||
      block "the scan could not be completed: could not ask jj where the git directory is."
    [ -n "$gitdir" ] && [ -d "$gitdir" ] ||
      block "the scan could not be completed: the git directory jj reported does not exist ('$gitdir')."
    GIT_DIR=$gitdir
    export GIT_DIR
    # commit_id is the git commit id, because jj stores its commits as git objects.
    # Running jj also snapshots the working copy, so the newest edits are included.
    extra_tips=$(jj log --no-graph -r 'visible_heads()' -T 'commit_id ++ "\n"' 2>/dev/null) ||
      block "the scan could not be completed: could not ask jj for the current commits."
    ;;
  *)
    block "unknown mode '$mode' (use 'git', 'git-hook' or 'jj')."
    ;;
esac

cd "$repo" || block "the scan could not be completed: cannot enter $repo."

# The range: local branches, tags and (jj) heads, minus everything any remote already has.
# `--not --remotes` must come last so it applies to everything before it.
range="--branches --tags"
for tip in $extra_tips; do
  range="$range $tip"
done
range="$range --not --remotes"

# Nothing outgoing (for example everything is already published)? Then nothing to scan.
# shellcheck disable=SC2086  # $range is a list of git options on purpose
outgoing=$(git rev-list $range 2>&1) ||
  block "the scan could not be completed: could not list outgoing commits ($outgoing)."
if [ -z "$outgoing" ]; then
  echo "secret-scan: no unpublished commits to scan."
  exit 0
fi

echo "secret-scan: scanning unpublished commits with gitleaks..." >&2

# gitleaks exits 42 for a finding and 1 for its own errors, so we can tell them apart.
# --redact hides the secret itself; the report still names the commit and file.
gitleaks git --no-banner --redact --verbose --exit-code 42 --log-opts="$range" "$repo"
status=$?

case $status in
  0)
    echo "secret-scan: clean." >&2
    exit 0
    ;;
  42)
    echo "secret-scan: BLOCKED - something resembling a secret was found (see Commit and File above)." >&2
    echo "secret-scan: fix or rewrite that commit, then push again. Nothing was pushed." >&2
    exit 1
    ;;
  *)
    block "the scan could not be completed: gitleaks failed with status $status."
    ;;
esac
